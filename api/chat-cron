import { supabase } from "../lib/db.js";
import { jsonResponse } from "../lib/cors.js";

// Auto-closes support threads that have gone quiet for 24+ hours. Triggered by Vercel
// Cron (see vercel.json's "crons" entry pointing at this route) — Vercel calls cron
// routes on a schedule with a GET request, so this only needs to handle GET.
//
// Cron routes are otherwise just a normal public URL, so this is gated by a
// CRON_SECRET env var checked against the Authorization header. Vercel automatically
// sends `Authorization: Bearer ${CRON_SECRET}` on cron-triggered requests once
// CRON_SECRET is set as an env var in the project — no extra config needed beyond that.
// A manual call without the right header is rejected the same way.
const AUTO_CLOSE_AFTER_MS = 24 * 60 * 60 * 1000;

export default {
  async fetch(request) {
    const expected = process.env.CRON_SECRET;
    const auth = request.headers.get("authorization") || "";
    if (!expected || auth !== `Bearer ${expected}`) {
      return jsonResponse({ error: "Not authorized." }, { status: 401 });
    }

    try {
      const cutoff = new Date(Date.now() - AUTO_CLOSE_AFTER_MS).toISOString();
      const { data, error } = await supabase
        .from("chat_threads")
        .update({ status: "closed" })
        .eq("status", "open")
        .lt("last_message_at", cutoff)
        .select("id");
      if (error) throw error;

      return jsonResponse({ ok: true, closed: (data || []).length });
    } catch (err) {
      console.error("chat-cron error:", err);
      return jsonResponse({ error: "Auto-close job failed." }, { status: 500 });
    }
  }
};
